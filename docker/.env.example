# Copy to docker/.env (gitignored). NOTHING SECRET GOES IN HERE: passwords
# live in ${SECRETS_DIR} and config.php. See docs/migration/plan.md.

# Project / labels. Production: onevoice. Lab rehearsal: onevoice-rehearsal.
COMPOSE_PROJECT_NAME=onevoice
HOMELAB_APP=onevoice

# Where all state lives (bind mounts) and where the DB password files are.
ONEVOICE_ROOT=/srv/onevoice
SECRETS_DIR=/etc/onevoice/secrets

# Must match config.php's dbname / dbuser (migrate-from-native.sh checks).
DB_NAME=nextcloud
DB_USER=nextcloud

# Published address of the web container. cloudflared expects localhost:80.
WEB_BIND=127.0.0.1:80
# Must match the trusted_proxies entry migrate-from-native.sh writes.
FRONTEND_SUBNET=172.31.250.0/24

# Relative to this directory (the repo checkout).
DIRECT_DOWNLOAD_SRC=../nextcloud-app/direct_download

# Images. Pin digests here after the rehearsal (image@sha256:...).
NEXTCLOUD_IMAGE=onevoice/nextcloud:30.0.0-fpm-ov1
MARIADB_IMAGE=mariadb:10.11
VALKEY_IMAGE=valkey/valkey:8.0
NGINX_IMAGE=nginx:1.26-alpine
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1

# Ceilings sized for the 3 vCPU / 5.8 GiB Bluehost VPS.
APP_MEM_LIMIT=2g
APP_CPUS=2.0
CRON_MEM_LIMIT=768m
CRON_CPUS=1.0
DB_MEM_LIMIT=768m
DB_CPUS=1.0
VALKEY_MEM_LIMIT=192m
VALKEY_CPUS=0.5
WEB_MEM_LIMIT=128m
WEB_CPUS=0.5
